# env/ebook.env on each host (owner places it at /opt/mumate/env/ebook.env, chmod 600). Never commit real values.
# staging | production | development
MUMATE_ENV=
# staging: the pgstaging database on mumate-2 · production: the MuMate Supabase database
EBOOK_DATABASE_URL=
# ManyChat → Settings → API (one key per page; the same key on staging and production)
MANYCHAT_API_KEY=
# Shared secret ManyChat sends in the X-Ebook-Hook-Secret header of the External Request; 32+ characters, one per env
EBOOK_HOOK_SECRET=
# Comma-separated ManyChat subscriber ids the app may message. Everyone else is refused and recorded as blocked.
EBOOK_ALLOWLIST=
# 1 = message anyone. Production only, and only after slice 4 of mumate-manychat-ebook-001. Unset = closed.
EBOOK_OPEN=
# --- Slice 2: slip check. Leave ALL unset to keep the slice 1 behaviour; set ALL or the app refuses to start. ---
# Slip2Go dashboard → API Connect → Authentication. API URL is the same for every account.
SLIP2GO_API_URL=https://connect.slip2go.com
SLIP2GO_SECRET_KEY=
# Receiver checked on every slip: Slip2Go bank code (KBank = 01004) and the account number, digits only. No name:
# real slips print the short company name.
EBOOK_RECEIVER_ACCOUNT_TYPE=
EBOOK_RECEIVER_ACCOUNT_NUMBER=
# Exact amount in baht the slip must show (production 95; staging a test amount such as 1)
EBOOK_PRICE=
# ManyChat flow ns (from the flow's URL): the delivery message, and the notice that shows {{bot_reason}} and tells the admin
EBOOK_FLOW_DELIVER=
EBOOK_FLOW_NOTICE=
# Optional: the team's E-Book room in Discord (Channel settings → Integrations → Webhooks). A green card per sale and a
# red card when a paid order still is not delivered after 4 tries. Empty = no posts. Secret: set with bin/env-set.sh.
EBOOK_DISCORD_WEBHOOK=
